{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zyx Academy",
  "version": "0.1.0-alpha.1",
  "identifier": "com.zyx.academy.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Zyx Academy",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["zyxacademy"]
      }
    }
  }
}
