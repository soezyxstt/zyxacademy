{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Zyx Academy desktop window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://www.zyxacademy.com/*",
      "https://staging.zyxacademy.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    "deep-link:default"
  ]
}
