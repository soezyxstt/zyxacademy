{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for Zyx Academy.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://www.zyxacademy.com/*",
      "https://staging.zyxacademy.com/*",
      "http://localhost:3000/*"
    ]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    "deep-link:default"
  ]
}
