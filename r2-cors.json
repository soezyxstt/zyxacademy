{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://staging.zyxacademy.com",
          "https://zyxacademy.com",
          "https://www.zyxacademy.com",
          "http://localhost:3000",
          "http://127.0.0.1:3000"
        ],
        "methods": [
          "GET",
          "PUT",
          "POST",
          "HEAD",
          "DELETE"
        ],
        "headers": [
          "*"
        ]
      },
      "exposedHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
