{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zyx-zyra-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "observability": {
    "traces": {
      "enabled": true
    }
  },
  "env": {
    "staging": {
      "name": "zyx-zyra-control-staging",
      "vars": {
        "ZYX_ENVIRONMENT": "staging",
        "ZYRA_DEPLOYMENT_VERSION": "plan-006",
        "ZYRA_CACHE_INDEX_NAME": "zyx-zyra-cache-staging",
        "ZYRA_PRIVATE_BUCKET_NAME": "zyx-zyra-private-staging",
        "ZYRA_ANALYTICS_DATASET": "zyx_zyra_events_staging"
      },
      "kv_namespaces": [
        {
          "binding": "ZYX_STAGING_KV",
          "id": "e44404ea69ba431bb0c68046475e45cf"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ZYRA_PRIVATE_ATTACHMENTS",
          "bucket_name": "zyx-zyra-private-staging"
        }
      ],
      "vectorize": [
        {
          "binding": "ZYRA_SEMANTIC_CACHE",
          "index_name": "zyx-zyra-cache-staging"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ZYRA_ANALYTICS",
          "dataset": "zyx_zyra_events_staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ZYRA_QUOTA_COORDINATOR",
            "class_name": "ZyraQuotaCoordinator"
          }
        ]
      },
      "exports": {
        "ZyraQuotaCoordinator": {
          "type": "durable-object",
          "state": "created",
          "storage": "sqlite"
        }
      }
    },
    "production": {
      "name": "zyx-zyra-control-production",
      "vars": {
        "ZYX_ENVIRONMENT": "production",
        "ZYRA_DEPLOYMENT_VERSION": "prod-v1",
        "ZYRA_CACHE_INDEX_NAME": "zyx-zyra-cache-production",
        "ZYRA_PRIVATE_BUCKET_NAME": "zyx-zyra-private-production",
        "ZYRA_ANALYTICS_DATASET": "zyx_zyra_events_production"
      },
      "kv_namespaces": [
        {
          "binding": "ZYX_KV",
          "id": "d447dde1d8ac42539130625e1face97d"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ZYRA_PRIVATE_ATTACHMENTS",
          "bucket_name": "zyx-zyra-private-production"
        }
      ],
      "vectorize": [
        {
          "binding": "ZYRA_SEMANTIC_CACHE",
          "index_name": "zyx-zyra-cache-production"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ZYRA_ANALYTICS",
          "dataset": "zyx_zyra_events_production"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ZYRA_QUOTA_COORDINATOR",
            "class_name": "ZyraQuotaCoordinator"
          }
        ]
      },
      "exports": {
        "ZyraQuotaCoordinator": {
          "type": "durable-object",
          "state": "created",
          "storage": "sqlite"
        }
      }
    }
  }
}
