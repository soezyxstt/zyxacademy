<?xml version="1.0" encoding="utf-8"?>
<!-- X path; identical to logo_z_draw but runs 150ms behind, matching the web. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:propertyName="trimPathEnd"
        android:valueFrom="0" android:valueTo="1"
        android:startOffset="150" android:duration="800"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator
        android:propertyName="fillAlpha"
        android:valueFrom="0" android:valueTo="1"
        android:startOffset="950" android:duration="400"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator
        android:propertyName="strokeAlpha"
        android:valueFrom="1" android:valueTo="0"
        android:startOffset="950" android:duration="300"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
