<?xml version="1.0" encoding="utf-8"?>
<!-- Splash-screen logo draw animation (system splash icon). Timing lives in
     res/animator/ and is shared with avd_logo_draw_full (in-app loading). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_logo_zyx_anim">
    <target android:name="pathZ" android:animation="@animator/logo_z_draw" />
    <target android:name="pathX" android:animation="@animator/logo_x_draw" />
</animated-vector>
