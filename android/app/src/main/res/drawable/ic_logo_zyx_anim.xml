<?xml version="1.0" encoding="utf-8"?>
<!-- Real Zyx logo (Z + X paths from components/logo.tsx), scaled into a 108
     viewport so it fits the splash-screen circular mask. Initial state is
     "undrawn" (trimPathEnd 0, fill hidden); only meaningful via avd_logo_draw.
     Scale is chosen so the drawn logo is ~126dp wide when the system renders
     the no-background splash icon at 288dp (108 x 126/288 = 47.25 viewport
     units), matching the in-app loading screen and the web route loader, so
     the logo does not jump in size across splash -> loading -> web. -->
