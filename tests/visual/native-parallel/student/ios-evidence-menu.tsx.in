import { useRouter } from "expo-router";
import { useState } from "react";
import { Keyboard, Platform, Pressable, StyleSheet, Text, TextInput } from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";

import cases from "../features/student/ios-evidence-cases.json";

type EvidenceCase = {
  label?: string;
  params: Record<string, string | string[] | undefined>;
};

export default function StudentIosEvidenceMenu() {
  const router = useRouter();
  const [id, setId] = useState("");
  const selected = (cases as Record<string, EvidenceCase>)[id];

  if (Platform.OS !== "ios") return null;

  return (
    <SafeAreaView testID="student-ios-menu" style={styles.screen}>
      <Text accessibilityRole="header" style={styles.title}>Student evidence</Text>
      <TextInput
        testID="student-ios-case-input"
        accessibilityLabel="Student case number"
        keyboardType="number-pad"
        value={id}
        onChangeText={value => setId(value.replace(/[^0-9]/g, "").slice(0, 3))}
        style={[styles.control, styles.text]}
      />
      {selected && (
        <Pressable
          accessibilityRole="button"
          testID={`student-ios-case-${id}`}
          style={styles.control}
          onPress={() => {
            Keyboard.dismiss();
            router.replace({ pathname: "/student-fixture", params: selected.params });
          }}
        >
          <Text style={styles.text}>{selected.label ?? `Open case ${id}`}</Text>
        </Pressable>
      )}
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  screen: { flex: 1, gap: 12, padding: 16, backgroundColor: "#fff" },
  title: { color: "#171717", fontSize: 18, fontWeight: "600" },
  control: { borderColor: "#767676", borderWidth: 1, borderRadius: 8, minHeight: 44, padding: 10, justifyContent: "center" },
  text: { color: "#171717" },
});
