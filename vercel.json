{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },
  "crons": [
    {
      "path": "/api/cron/analytics",
      "schedule": "0 0 * * *"
    }
  ]
}
