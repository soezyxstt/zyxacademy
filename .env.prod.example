# ==============================================================================
# Zyx Academy - Production Environment Variables Template (.env.prod)
# ==============================================================================
# Petunjuk:
# 1. Salin berkas ini ke .env.prod jika ingin mengonfigurasi environment production.
# 2. Isi nilai yang bertanda [WAJIB] untuk menjalankan fungsi inti aplikasi.
# 3. Jangan commit berkas .env.prod yang berisi kredensial asli ke git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Base URLs
# ------------------------------------------------------------------------------
NODE_ENV=production
# URL publik aplikasi (tanpa trailing slash), contoh: https://zyx.academy
BETTER_AUTH_URL=https://zyx.academy
NEXT_PUBLIC_APP_URL=https://zyx.academy

# ------------------------------------------------------------------------------
# 2. Better Auth & Security
# ------------------------------------------------------------------------------
# [WAJIB] Secret minimal 32 karakter (buat via: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# ------------------------------------------------------------------------------
# 3. Database (Turso Remote Production)
# ------------------------------------------------------------------------------
# [WAJIB] URL koneksi Turso remote (format: libsql://<nama-db>-<org>.turso.io)
DATABASE_URL=libsql://
TURSO_CONNECTION_URL=libsql://
# [WAJIB] Auth token database Turso production
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 4. Google OAuth & Workspace Integrations (Meet, Forms, Sheets, Drive)
# ------------------------------------------------------------------------------
# [WAJIB] Google OAuth credentials dari Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [WAJIB] Refresh token utama untuk sinkronisasi Google Meet, Forms, Sheets, Drive
GOOGLE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 5. AI & LLM Providers (Google Gemini)
# ------------------------------------------------------------------------------
# [WAJIB] Gemini API Key utama untuk AI Tutoring, evaluasi kuis, dan embeddings
GEMINI_API_KEY=
# Cadangan rotasi / load balancing Gemini API Key (opsional)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Alias non-secret untuk slot kunci Gemini (opsional)
GEMINI_PROJECT_ALIAS_1=
GEMINI_PROJECT_ALIAS_2=
GEMINI_PROJECT_ALIAS_3=
GEMINI_PROJECT_ALIAS_4=

# ------------------------------------------------------------------------------
# 6. Object Storage (Cloudflare R2)
# ------------------------------------------------------------------------------
# [WAJIB] Mode penyedia penyimpanan: 'r2' (standar)
STORAGE_PROVIDER_MODE=r2
# Cloudflare R2 S3-compatible credentials
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=zyx-storage
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 7. Semantic Search & Cloudflare Vectorize
# ------------------------------------------------------------------------------
# Provider vektor aktif ('vectorize')
VECTOR_STORE=vectorize
# URL Worker Vectorize yang sudah di-deploy (contoh: https://zyx-vector-api.<subdomain>.workers.dev)
VECTORIZE_WORKER_URL=
# Shared secret yang sama dengan konfigurasi Worker Vectorize
VECTORIZE_SHARED_SECRET=

# ------------------------------------------------------------------------------
# 8. Cloudflare AI Gateway, KV Cache, & Control Plane
# ------------------------------------------------------------------------------
# Cloudflare AI Gateway URL (format: https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/google-ai-studio)
CF_AI_GATEWAY_URL=
CF_AI_GATEWAY_TOKEN=
# Cloudflare Workers KV Cache untuk Zyx AI
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=
# Zyra Control Plane Worker
ZYRA_CONTROL_PLANE_URL=https://zyx-zyra-control-production.16922204.workers.dev
ZYRA_CONTROL_PLANE_TOKEN=

# ------------------------------------------------------------------------------
# 9. Background Jobs (Inngest)
# ------------------------------------------------------------------------------
# [WAJIB] Event key Inngest untuk pengiriman background jobs
INNGEST_EVENT_KEY=
# Signing key Inngest untuk verifikasi request di production (opsional tetapi disarankan)
INNGEST_SIGNING_KEY=

# ------------------------------------------------------------------------------
# 10. Email & WhatsApp Notifications
# ------------------------------------------------------------------------------
# [WAJIB] Resend API Key untuk email transaksional
RESEND_API_KEY=
# Nomor WhatsApp admin (format angka: 6281234567890)
WHATSAPP_ADMIN_NUMBER=
# Nomor WhatsApp publik fallback untuk tombol bantuan di UI
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# 11. Real-time Classroom & Diktat PDF Renderer
# ------------------------------------------------------------------------------
# Shared secret untuk HMAC token kuis langsung (P9)
LIVE_HMAC_SECRET=
# URL Worker real-time kuis (contoh: https://zyx-realtime.<subdomain>.workers.dev)
NEXT_PUBLIC_REALTIME_URL=
# Diktat PDF Renderer service (Cloudflare Worker dengan Browser Run Quick Actions)
DIKTAT_RENDERER_URL=
DIKTAT_RENDERER_SECRET=

# ------------------------------------------------------------------------------
# 12. Monitoring & Analytics (Sentry & PostHog)
# ------------------------------------------------------------------------------
# Sentry error monitoring
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PUBLIC_KEY=
SENTRY_OTLP_TRACES_URL=
SENTRY_VERCEL_LOG_DRAIN_URL=
NEXT_PUBLIC_SENTRY_DSN=
# PostHog analytics & feature flags
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# 13. Brand, Kalkulator, & Integrasi Publik
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_EMAIL=contact@zyxacademy.com
NEXT_PUBLIC_BRAND_INSTAGRAM=https://instagram.com/zyx_academy
NEXT_PUBLIC_BRAND_TIKTOK=https://tiktok.com/@zyx_academy
# API Key Desmos Graphing Calculator (https://www.desmos.com/my-api)
NEXT_PUBLIC_DESMOS_API_KEY=

# ------------------------------------------------------------------------------
# 14. Google Analytics & Firebase Push Notifications (Opsional)
# ------------------------------------------------------------------------------
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 15. Feature Flags ("1" = aktif, "0" atau kosong = nonaktif)
# ------------------------------------------------------------------------------
# Program Tutorial PKA dan simulasi kuis bertahap
FEATURE_PKA=1
# Email mingguan pengingat refleksi belajar
FEATURE_REFLECTION_EMAIL=1
# Kuis interaktif real-time classroom
FEATURE_LIVE=1
# Saran audit AI pada materi Diktat
FEATURE_DIKTAT_AI=1
# Fitur upload foto coretan untuk Zyra AI tutoring
FEATURE_ZYRA_IMAGE_INPUT_V1=1
NEXT_PUBLIC_FEATURE_ZYRA_IMAGE_INPUT_V1=1
# Cache semantik Zyra AI berbasis Vectorize
FEATURE_ZYRA_SEMANTIC_CACHE_V1=1
# Sinkronisasi hak editor spreadsheet admin secara otomatis
FEATURE_DRIVE_EDITOR_SYNC=1
# Structured Article V3 reader & authoring
FEATURE_STRUCTURED_ARTICLE_READER_V1=1
